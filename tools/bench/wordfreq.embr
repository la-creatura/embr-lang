# 200k generated words: join, split and a map of counts (string hashing and map updates)
import "embrlib"
import "str"
words = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu", "nu", "xi", "omicron", "pi", "rho", "sigma", "tau", "upsilon"]
seed = 12345
parts = []
i = 0
while i < 200000
    seed = (seed * 1103515245 + 12345) % 2147483648
    parts = push(parts, words[seed % 20])
    i = i + 1
end
text = join(parts, " ")
counts = {}
for w in str_split(text, " ")
    if has(counts, w)
        counts[w] = counts[w] + 1
    else
        counts[w] = 1
    end
end
print(len(keys(counts)))
print(counts["alpha"])
print(counts["upsilon"])
print(len(text))
