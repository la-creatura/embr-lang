    while i < 100000
        path_join("/usr", "local", "lib/x.so")
        i += 1
    end
end, 3))
row("100k x relative", best(fn()
    i = 0
    while i < 100000
        path_relative("/a/b/c/d/e", "/a/b/x/y")
        i += 1
    end
end, 3))
