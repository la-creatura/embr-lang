%YAML 1.2
---
# embr syntax for sublime text. same rules as the vs code grammar, see ../vscode/README.md.
name: embr
file_extensions:
  - embr
scope: source.embr

variables:
  ident: '[A-Za-z_][A-Za-z0-9_]*'
  type: '(?:int|num|str|arr|map|fn|ptr|any)'

contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - include: fn-definition
    - include: type-annotation
    - include: keywords
    - include: constants
    - include: function-call
    - include: operators
    - include: punctuation

  comments:
    # block comments do not nest
    - match: '#\['
      scope: punctuation.definition.comment.begin.embr
      push: block-comment
    - match: '(#)(?!\[).*$'
      scope: comment.line.number-sign.embr
      captures:
        1: punctuation.definition.comment.embr

  block-comment:
    - meta_include_prototype: false
    - meta_scope: comment.block.embr
    - match: '\]#'
      scope: punctuation.definition.comment.end.embr
      pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.embr
      push: string

  string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.double.embr
    - match: '"'
      scope: punctuation.definition.string.end.embr
      pop: true
    # an unterminated string ends at the end of the line
    - match: '$'
      pop: true
    - match: '\\(?:[ntr0"\\]|x\h{2}|u\h{4}|u\{\h{1,6}\})'
      scope: constant.character.escape.embr
    - match: '\\.'
      scope: invalid.illegal.unknown-escape.embr

  numbers:
    - match: '(?<![\w.])\d+(?:\.\d+)?[eE][+-]?\d+(?![\w.])'
      scope: constant.numeric.float.embr
    - match: '(?<![\w.])\d+\.\d+(?![\w.])'
      scope: constant.numeric.float.embr
    - match: '(?<![\w.])\d+(?![\w.])'
      scope: constant.numeric.integer.embr
    - match: '(?<![\w.])\d+\.(?!\d)|\d+\.\d+\.[\d.]*'
      scope: invalid.illegal.number.embr

  fn-definition:
    - match: '\b(fn)\s+({{ident}})'
      captures:
        1: storage.type.function.embr
        2: entity.name.function.embr

  type-annotation:
    # x: num
    - match: '(:)\s*\b({{type}})\b'
      captures:
        1: punctuation.separator.annotation.embr
        2: support.type.embr
    # -> num
    - match: '(->)\s*\b({{type}})\b'
      captures:
        1: keyword.operator.arrow.embr
        2: support.type.embr
    # local int x = 5, local auto x = 5
    - match: '\b(local)\s+({{type}}|auto)\b'
      captures:
        1: storage.modifier.embr
        2: support.type.embr

  keywords:
    - match: '\b(?:if|elif|else)\b'
      scope: keyword.control.conditional.embr
    - match: '\b(?:while|for|in|break|continue)\b'
      scope: keyword.control.loop.embr
    - match: '\b(?:return|try|catch|end)\b'
      scope: keyword.control.flow.embr
    - match: '\bimport\b'
      scope: keyword.control.import.embr
    - match: '\bfn\b'
      scope: storage.type.function.embr
    - match: '\b(?:local|const|auto)\b'
      scope: storage.modifier.embr
    - match: '\b(?:and|or)\b'
      scope: keyword.operator.logical.embr

  constants:
    # not keywords, they come from the embrtypes plugin, but worth colouring
    - match: '\b(?:true|false|nil)\b'
      scope: constant.language.embr

  function-call:
    - match: '\b{{ident}}(?=\s*\()'
      scope: variable.function.embr

  operators:
    - match: '\+=|-=|\*=|/='
      scope: keyword.operator.assignment.compound.embr
    - match: '<<|[|^~]'
      scope: keyword.operator.bitwise.embr
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.embr
    - match: '\.\.\.'
      scope: keyword.operator.spread.embr
    - match: '(?<!\.)\.\.(?!\.)'
      scope: invalid.illegal.range.embr
    - match: '='
      scope: keyword.operator.assignment.embr
    - match: '[-+*/%]'
      scope: keyword.operator.arithmetic.embr
    - match: '!'
      scope: keyword.operator.logical.embr

  punctuation:
    - match: '\.'
      scope: punctuation.accessor.embr
    - match: ','
      scope: punctuation.separator.comma.embr
    - match: ':'
      scope: punctuation.separator.key-value.embr
