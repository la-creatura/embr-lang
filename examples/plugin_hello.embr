# uses the plugin built from examples/hello/hello.cpp -- see the writing-plugins wiki page
import "hello"

print(hello_greet("wowwd"))
print(hello_greet("embr", "Hi"))

# two functions, hello_describe__1 and hello_describe__2, are one name: embr picks by the argument
print(hello_describe("abc"))
print(hello_describe(21))

c = hello_counter()
hello_counter_add(c, 5)
hello_counter_add(c, 37)
print(hello_counter_get(c))

# the handle is opaque and unforgeable: a map pretending to be one is rejected. (the values are kept as `any`, so that it is
# the run-time check you see: embr already refuses an argument it can tell is wrong before the script runs)
local any forged = {"__type": "hello.counter"}
local any five = 5
try
    hello_counter_get(forged)
catch e
    print("rejected a forged handle")
end

# arity and types are checked for you by bindSig()
try
    hello_greet(five)
catch e
    print("rejected a non-string")
end

# calling back into script code from native code
print(hello_map_sum([1, 2, 3], fn(x) return x * 10 end))
try
    hello_map_sum([1], fn(x) return "not a number" end)
catch e
    print(e["message"])
end
