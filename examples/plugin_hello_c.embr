# a plugin written in C (examples/hello_c/hello_c.c)
import "embrlib"
import "hello_c"

print(hc_twice(21))
print(hc_join(["a", "b", "c"], "-"))
print(hc_join(["x", "y"]))
c = hc_counter()
hc_counter_add(c, 5)
hc_counter_add(c, 2)
print(hc_counter_get(c))
m = hc_pair(7)
print(m["n"], m["square"])

print(hc_chars("abc"))
print(hc_kinds([1, 2.5, "x", [1], {"a": 1}]))
print(hc_loads())
print(hc_upper("héllo wörld"))
print(hc_show([1, "a", 2.5, {"k": 2}]))
print(hc_show(2.50), hc_show(-7), hc_show("txt"))
print(hc_sum([1, 2, 3, 4]), hc_sum([]), hc_sum([5...100]))
sq = hc_squares(6)
print(sq, len(sq))
print(len(hc_squares(100000)))

# an error from C is an ordinary error a script can catch
try
    hc_fail("nope")
catch e
    print("caught:", e["message"])
end
try
    hc_join([1, 2])
catch e
    print("caught:", e["message"])
end
# a pointer that did not come from the plugin is refused
try
    hc_counter_get(hc_counter)
catch e
    print("caught a wrong handle")
end
# a kind of its own, and the label of the function when there is none
try
    hc_fail_kind("mykind", "with a kind")
catch e
    print("caught:", e["kind"], e["message"])
end
try
    hc_sum([1, "x"])
catch e
    print("caught:", e["kind"], e["message"])
end
try
    hc_fail("plain")
catch e
    print("caught:", e["kind"])
end
