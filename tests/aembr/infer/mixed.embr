import "embrlib"
# with --infer, a parameter or a result that the calls and returns give different types is an any
fn show(x)
    return str(x) + "!"
end
fn pick(flag, a, b)
    if flag
        return a
    end
    return b
end
fn kind(x)
    if x
        return 1
    end
    return "none"
end
print(show(1), show("s"), show(2.5), show([1, 2]))
print(pick(1, "left", 2), pick(0, "left", 2), pick(1, 3, 4))
print(kind(5), kind(0))
fn add(a, b)
    return a + b
end
print(add(1, 2), add(1.5, 2), add("a", "b"), add("n", 3))
