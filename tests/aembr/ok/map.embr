# map insert, lookup and overwrite (string keys), all done where the map lives, so the cost is linear.
import "embrlib"
n = 100000
m = {}
i = 0
while i < n
    m["k" + str(i)] = i
    i = i + 1
end
total = 0
i = 0
while i < n
    total = total + m["k" + str(i)]
    i = i + 1
end
i = 0
while i < n
    m["k" + str(i)] = i * 2
    i = i + 1
end
print(total)
print(m["k99999"])
