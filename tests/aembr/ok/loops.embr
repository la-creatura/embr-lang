# for over a range and over an array, break and continue, a loop var that is used after the loop
import "embrlib"
total = 0
for i in [1...10]
    if i % 2 == 0
        continue
    end
    total = total + i
end
print(total)
print(total + 1000)
xs = [3, 1, 4, 1, 5, 9, 2, 6]
best = 0
for x in xs
    if x > best
        best = x
    end
    if x == 9
        break
    end
end
print(best)
fl = [1.5, 2.25, 3.0]
s = 0.0
for f in fl
    s = s + f
end
print(s)
for k in [5...4]
    print(k)
end
words = ["a", "bb", "ccc"]
n = 0
for w in words
    n = n + len(w)
end
print(n)
