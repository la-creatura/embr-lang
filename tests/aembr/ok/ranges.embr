import "embrlib"
# ranges with a step, and ranges as arrays
for i in [10, 7...0]
    print(i)
end
total = 0
for i in [1, 3...99]
    total += i
end
print(total)
for i in [5...1]
    print("never")
end
x = [1...5]
print(len(x), x[4])
y = [5, 4...1]
print(len(y), y[0], y[4])
z = [1, 5...1]
print(len(z))
a = 2
w = [a...a * 3]
print(len(w), w[0], w[4])
print(len([5...1]))
for i in [0, 5...20]
    print(i)
end
try
    q = [1, 1...5]
catch e
    print(e["message"])
end
try
    for i in [2, 2...9]
        print(i)
    end
catch e
    print(e["message"])
end
