# array build, index reads and index writes (all done where the array lives, so the cost is linear).
import "embrlib"
n = 200000
arr = []
i = 0
while i < n
    arr = push(arr, i * 2)
    i = i + 1
end
sum_ = 0
r = 0
while r < 5
    i = 0
    while i < n
        sum_ = sum_ + arr[i]
        i = i + 1
    end
    r = r + 1
end
r = 0
while r < 3
    i = 0
    while i < n
        arr[i] = arr[i] + 1
        i = i + 1
    end
    r = r + 1
end
i = 0
while i < n
    append(&arr, i)
    i = i + 1
end
print(sum_)
print(arr[n - 1])
print(len(arr))
